# Copy to .env and fill in for MySQL mode. If these aren't set, the app
# automatically falls back to the local JSON file store (fine for local dev,
# not for production — see DEPLOY.md).

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional
NODE_ENV=development
PORT=4000

# Public URL of the deployed app (used to build PayPal return/cancel URLs).
APP_URL=http://localhost:5173

# ---------- AI-assist (draft content, coach, narrative, recommendations) ----------
# Without these, AI endpoints return a clear 503 instead of crashing the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- PayPal subscriptions (Pro/Team billing) ----------
# Create a PayPal Business account -> Apps & Credentials for CLIENT_ID/SECRET.
# Create two subscription Products/Plans (Pro, Team) under Apps & Credentials ->
# Subscriptions, and paste their Plan IDs below. Set PAYPAL_ENV=live only once
# you've tested end-to-end against sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_TEAM=
# From the webhook's page in the PayPal dashboard, after pointing it at
# https://<your-app-domain>/api/billing/webhook
PAYPAL_WEBHOOK_ID=
